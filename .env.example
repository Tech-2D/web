# A configuração pública do Firebase já está em src/firebase.ts.
# Ativar somente após migration 024 e publicação do endpoint /api/pegaki.
VITE_PEGAKI_CLOUD_GRADES=false
# Se quiser sobrescrever algum valor, use as variáveis abaixo:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# API personalizada (opcional). Sem ela, mantém o envio original do Firebase.
# VITE_PASSWORD_RESET_API_URL=https://sua-api.vercel.app/api/forgot-password
# Anexos privados no Cloudflare R2.
VITE_ATTACHMENTS_ENABLED=false
# A API só libera CORS para o site publicado. Em desenvolvimento, use o proxy
# do vite.config.ts (leituras funcionam; gravações exigem o site publicado):
# VITE_API_URL=/tech2d-api
